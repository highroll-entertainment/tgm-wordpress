{
  "name": "terragaming/terragaming-media-ads",
  "description": "TerraGaming Media Ads — the WordPress plugin (Composer is for development only; the plugin has no runtime dependencies).",
  "type": "wordpress-plugin",
  "license": "MIT",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "brain/monkey": "^2.7",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6 || ^10 || ^11 || ^12 || ^13",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs"
  }
}
